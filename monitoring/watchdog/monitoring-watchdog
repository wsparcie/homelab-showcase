#!/bin/bash
# Monitoring container: dead-man's switch for the monitoring stack. Every 5 min, ping healthchecks.io only if Prometheus is
# ready AND scraping, Grafana's DB is healthy and blackbox answers. If the CT, the host, the power or the internet
# is down, the pings stop and healthchecks.io alerts from outside the house (Discord/e-mail).
set -uo pipefail
HC=$(sed -n 's/^HC_MONITORING=//p' /etc/healthchecks-monitoring 2>/dev/null)
[ -n "$HC" ] || { echo "no HC_MONITORING"; exit 1; }
P=http://127.0.0.1:9090
fail=()
curl -fsS -m 5 -o /dev/null $P/-/ready || fail+=("prometheus not ready")
# scraping really happens: node-exporter on the hypervisor sampled within the last 3 minutes
age=$(curl -fsS -m 5 -G $P/api/v1/query --data-urlencode 'query=time() - max(timestamp(up{job="node-exporter"}))' \
      | python3 -c 'import sys,json; r=json.load(sys.stdin)["data"]["result"]; print(int(float(r[0]["value"][1])) if r else 99999)' 2>/dev/null || echo 99999)
[ "$age" -lt 180 ] || fail+=("no fresh scrape (${age}s)")
curl -fsS -m 5 http://127.0.0.1:3000/api/health 2>/dev/null | grep -q '"database": *"ok"' || fail+=("grafana unhealthy")
curl -fsS -m 5 -o /dev/null http://127.0.0.1:9115/-/healthy || fail+=("blackbox down")
if [ ${#fail[@]} -eq 0 ]; then
  curl -fsS -m 10 --retry 3 -o /dev/null "$HC"
else
  printf '%s\n' "${fail[@]}" | curl -fsS -m 10 --retry 3 -o /dev/null --data-binary @- "$HC/fail"
  printf '%s\n' "${fail[@]}"; exit 1
fi
